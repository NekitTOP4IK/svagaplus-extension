# Copy to .env and fill in values for local development.
# Prod values have built-in defaults; dev values are required for dev/firefox_dev targets.

# Production (defaults are baked into webpack.config.js, override only if self-hosting)
# BACKEND_URL_PROD=https://svagaplus.com
# FRONTEND_URL_PROD=https://svagaplus.com

# Development (required for dev/firefox_dev targets)
BACKEND_URL_DEV=
FRONTEND_URL_DEV=
